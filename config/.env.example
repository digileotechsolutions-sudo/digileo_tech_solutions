# Application
APP_NAME="Digileo Tech Solutions"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://digileotechsolutions.com

# Database
DB_HOST=localhost
DB_NAME=digileo_chat
DB_USER=your_database_user
DB_PASS=your_database_password

# OpenAI (for WhatsApp Chat AI)
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-3.5-turbo

# Email (for contact/quote form submissions)
SMTP_HOST=mail.yourdomain.com
SMTP_PORT=587
SMTP_USER=your_email@yourdomain.com
SMTP_PASS=your_email_password
SMTP_FROM=your_email@yourdomain.com
SMTP_FROM_NAME="Digileo Tech Solutions"
NOTIFICATION_EMAIL=digileotechsolutions@gmail.com
